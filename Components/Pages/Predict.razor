@page "/predict"
@using PredictorBlazor.Services
@rendermode InteractiveServer
@inject PredictorService Predictor
@inject LlmInsightService LlmInsight
@inject IWebHostEnvironment Env
@inject ILogger<Predict> Logger
@inject NavigationManager Nav

<PageTitle>Match Predictions - EPL Predictor AI</PageTitle>

<!-- Page Title Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="mb-1" style="font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 800;">🎯 EPL Match Predictions</h1>
        <p class="text-secondary mb-0" style="font-size: 0.95rem;">
            Predicting upcoming Premier League fixtures via Dixon-Coles goal expectation and calibrated Tree Ensembles.
        </p>
    </div>

    <div class="page-header-actions d-flex align-items-center gap-2 flex-wrap">
        <button class="btn btn-brand-primary" @onclick="() => PredictFromBundled(true)" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Computing...</span>
            }
            else
            {
                <span>⚡ Generate Predictions</span>
            }
        </button>

        <button class="btn btn-brand-secondary" @onclick="UpdateFixtures" disabled="@IsLoading">
            🔄 Update Fixtures
        </button>

        <button class="btn btn-brand-outline" @onclick="SyncAllSeasons" disabled="@IsLoading" title="Download historical seasons plus the current campaign">
            🌐 Sync Multi-Season Data
        </button>
    </div>
</div>

<!-- Status Banner -->
@if (!string.IsNullOrWhiteSpace(Status))
{
    <div class="glass-card mb-4 fade-in py-3 px-4 d-flex align-items-center gap-3" style="border-left: 4px solid var(--brand-cyan);">
        <span style="font-size: 1.35rem;">ℹ️</span>
        <div class="flex-grow-1" style="font-size: 0.925rem; font-weight: 500;">@Status</div>
        @if (IsLoading)
        {
            <div class="spinner-border spinner-border-sm text-info" role="status"></div>
        }
    </div>
}

@if (IsLoading && Session is null)
{
    <!-- Active Machine Learning Computation Hero Card -->
    <div class="glass-card mb-4 text-center py-5 px-4 fade-in" style="border: 1px solid var(--border-bright); background: radial-gradient(circle at center, rgba(16, 185, 129, 0.08) 0%, var(--bg-card) 70%);">
        <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25);">
            <div class="spinner-border text-success" style="width: 2.75rem; height: 2.75rem;" role="status"></div>
        </div>

        <h3 class="fs-4 fw-bold text-light mb-2">Analyzing Premier League Matchday...</h3>
        <p class="text-secondary mb-3 mx-auto" style="max-width: 600px; font-size: 0.95rem;">
            Fitting Dixon-Coles goal expectation parameters, evolving Elo strength curves, and stacking Random Forest and Gradient Boosting probability models.
        </p>

        <!-- Progress bar -->
        <div class="progress-bar-animated-gradient mx-auto mb-4" style="max-width: 480px;"></div>

        <!-- 4 Step Status Pipeline -->
        <div class="d-flex justify-content-center gap-4 flex-wrap text-start mx-auto" style="max-width: 700px;">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success rounded-pill px-2">✓</span>
                <span class="small text-light fw-semibold">3,500+ Fixtures Ingested</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="spinner-grow spinner-grow-sm text-info" role="status"></span>
                <span class="small text-info fw-semibold">Dixon-Coles & Elo Calibration</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="status-dot"></span>
                <span class="small text-secondary">Tree Ensembles & Stacking</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="status-dot"></span>
                <span class="small text-secondary">AI Tactical Insights</span>
            </div>
        </div>
    </div>

    <!-- Shimmer Skeleton Match Cards -->
    <div class="row g-2 g-md-3 mb-4 fade-in">
        @for (int i = 0; i < 4; i++)
        {
            <div class="col-12 col-lg-6">
                <div class="skeleton-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="skeleton-shimmer" style="width: 140px; height: 16px;"></div>
                        <div class="skeleton-shimmer" style="width: 90px; height: 16px;"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center my-4">
                        <div class="d-flex align-items-center gap-2">
                            <div class="skeleton-shimmer rounded-circle" style="width: 42px; height: 42px;"></div>
                            <div class="skeleton-shimmer" style="width: 110px; height: 20px;"></div>
                        </div>
                        <div class="skeleton-shimmer" style="width: 32px; height: 18px;"></div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="skeleton-shimmer" style="width: 110px; height: 20px;"></div>
                            <div class="skeleton-shimmer rounded-circle" style="width: 42px; height: 42px;"></div>
                        </div>
                    </div>
                    <div class="skeleton-shimmer w-100 mb-2" style="height: 12px; border-radius: 6px;"></div>
                    <div class="skeleton-shimmer w-75" style="height: 12px; border-radius: 6px;"></div>
                </div>
            </div>
        }
    </div>
}

@if (!IsLoading && Session is null)
{
    <div class="glass-card mb-4 text-center py-5 px-4 fade-in">
        <span style="font-size: 3rem;">⚽</span>
        <h3 class="fs-4 fw-bold text-light mt-3 mb-2">No Active Prediction Session</h3>
        <p class="text-secondary mb-4 mx-auto" style="max-width: 500px;">
            Click below to load historical match data and generate model forecasts for the upcoming round.
        </p>
        <button class="btn btn-brand-primary px-4 py-2.5" @onclick="() => PredictFromBundled(true)">
            ⚡ Run Match Predictions
        </button>
    </div>
}

@if (IsLoading && Session is not null)
{
    <div class="glass-card mb-3 py-2.5 px-4 d-flex align-items-center justify-content-between gap-3 border-success fade-in" style="background: rgba(16, 185, 129, 0.1);">
        <div class="d-flex align-items-center gap-2.5">
            <span class="spinner-border spinner-border-sm text-success" role="status"></span>
            <span class="fw-semibold text-light" style="font-size: 0.9rem;">
                Re-evaluating match models and calculating live predictions...
            </span>
        </div>
        <div class="progress-bar-animated-gradient" style="width: 180px;"></div>
    </div>
}

<!-- Session Info Widget Row -->
@if (Session is not null)
{
    <div class="row g-2 g-md-3 mb-4 fade-in">
        <div class="col-12 col-md-4">
            <div class="stat-widget">
                <div>
                    <div class="stat-widget-label">Last Completed Round</div>
                    <div class="stat-widget-value text-secondary">Round @Session.LastCompletedRound</div>
                </div>
                <div class="stat-widget-sub">Finished scores analyzed</div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="stat-widget" style="border-color: rgba(16, 185, 129, 0.35);">
                <div>
                    <div class="stat-widget-label" style="color: var(--brand-primary);">Target Prediction Round</div>
                    <div class="stat-widget-value" style="color: var(--brand-primary);">Round @Session.NextRound</div>
                </div>
                <div class="stat-widget-sub">Upcoming unplayed fixtures</div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="stat-widget">
                <div>
                    <div class="stat-widget-label">Training Matches</div>
                    <div class="stat-widget-value text-info">@Session.TotalMatchesTrained</div>
                </div>
                <div class="stat-widget-sub">Across @Session.LoadedSeasons.Count active season datasets</div>
            </div>
        </div>
    </div>

    <!-- Predictions Container -->
    @if (Session.NextRoundPredictions?.Count > 0)
    {
        <div class="glass-card mb-4 fade-in" style="@(IsLoading ? "opacity: 0.55; pointer-events: none; transition: opacity 0.2s;" : "transition: opacity 0.2s;")">
            <!-- Filter & View Controls -->
            <div class="filter-controls-row d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 gap-md-3 pb-3 border-bottom" style="border-color: var(--border-subtle) !important;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h2 class="fs-5 fs-md-4 fw-bold mb-0 text-light me-2">⚽ Round @Session.NextRound Fixtures</h2>
                    <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1">@FilteredPredictions.Count() Matches</span>
                </div>

                <div class="filter-controls-actions d-flex align-items-center gap-2 flex-wrap w-100-mobile">
                    <!-- Search Input -->
                    <input type="text" class="custom-input search-filter-input" placeholder="Filter team..." @bind="SearchQuery" @bind:event="oninput" />

                    <!-- Outcome Filter Buttons -->
                    <div class="btn-group flex-grow-1" role="group">
                        <button type="button" class="btn btn-sm @(OutcomeFilter == "ALL" ? "btn-brand-primary" : "btn-brand-outline")" @onclick='() => SetFilter("ALL")'>All</button>
                        <button type="button" class="btn btn-sm @(OutcomeFilter == "H" ? "btn-brand-primary" : "btn-brand-outline")" @onclick='() => SetFilter("H")'>Home</button>
                        <button type="button" class="btn btn-sm @(OutcomeFilter == "D" ? "btn-brand-primary" : "btn-brand-outline")" @onclick='() => SetFilter("D")'>Draw</button>
                        <button type="button" class="btn btn-sm @(OutcomeFilter == "A" ? "btn-brand-primary" : "btn-brand-outline")" @onclick='() => SetFilter("A")'>Away</button>
                    </div>

                    <!-- View Toggle -->
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-sm @(ViewMode == "CARDS" ? "btn-brand-secondary" : "btn-brand-outline")" @onclick='() => ViewMode = "CARDS"' title="Card View">
                            🔲
                        </button>
                        <button type="button" class="btn btn-sm @(ViewMode == "TABLE" ? "btn-brand-secondary" : "btn-brand-outline")" @onclick='() => ViewMode = "TABLE"' title="Table View">
                            📋
                        </button>
                    </div>
                </div>
            </div>

            @if (!FilteredPredictions.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <span class="fs-1 d-block mb-2">🔍</span>
                    <h4 class="fs-5 fw-bold text-light mb-1">No matching fixtures</h4>
                    <p class="small text-muted mb-3">No matches found matching "@SearchQuery" with filter "@OutcomeFilter".</p>
                    <button class="btn btn-sm btn-brand-outline" @onclick='() => { SearchQuery = ""; OutcomeFilter = "ALL"; }'>
                        Clear Filters
                    </button>
                </div>
            }
            else if (ViewMode == "CARDS")
            {
                <div class="row g-3">
                    @foreach (var p in FilteredPredictions.OrderBy(x => x.Kickoff))
                    {
                        <div class="col-12 col-lg-6">
                            <div class="fixture-card">
                                <!-- Match Header -->
                                <div class="match-header-meta">
                                    <span>📅 @p.Kickoff.ToString("ddd, MMM dd • HH:mm") GMT</span>
                                    <span class="xg-badge">
                                        ⚽ xG: @p.ExpectedHomeGoals.ToString("0.0") - @p.ExpectedAwayGoals.ToString("0.0")
                                    </span>
                                </div>

                                <!-- Teams Row -->
                                <div class="team-row">
                                    <div class="team-profile">
                                        <div class="team-avatar home-badge">@GetMonogram(p.HomeTeam)</div>
                                        <div>
                                            <h3 class="team-name">@p.HomeTeam</h3>
                                            <span class="team-sublabel">Home</span>
                                        </div>
                                    </div>

                                    <div class="match-vs-divider">VS</div>

                                    <div class="team-profile justify-content-end text-end">
                                        <div>
                                            <h3 class="team-name">@p.AwayTeam</h3>
                                            <span class="team-sublabel">Away</span>
                                        </div>
                                        <div class="team-avatar away-badge">@GetMonogram(p.AwayTeam)</div>
                                    </div>
                                </div>

                                <!-- Prediction Verdict & Confidence -->
                                <div class="d-flex justify-content-between align-items-center pt-2 pb-2 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-secondary small fw-semibold">AI Verdict:</span>
                                        <span class="prediction-pill @GetOutcomeClass(p.PredictedOutcome)">
                                            @OutcomeText(p.PredictedOutcome)
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-secondary small">Confidence:</span>
                                        <span class="fw-bold" style="color: var(--brand-primary); font-size: 1.05rem;">
                                            @p.Probability.ToString("P0")
                                        </span>
                                    </div>
                                </div>

                                <!-- 1X2 Probabilities Bar -->
                                <div class="probs-bar-container">
                                    <div class="probs-bar-labels">
                                        <span style="color: #34d399;">1 (Home): @((p.HomeWinProb * 100).ToString("0"))%</span>
                                        <span style="color: #fbbf24;">X (Draw): @((p.DrawProb * 100).ToString("0"))%</span>
                                        <span style="color: #38bdf8;">2 (Away): @((p.AwayWinProb * 100).ToString("0"))%</span>
                                    </div>
                                    <div class="probs-bar-visual">
                                        <div class="prob-fill-home" style="width: @((p.HomeWinProb * 100).ToString("0"))%"></div>
                                        <div class="prob-fill-draw" style="width: @((p.DrawProb * 100).ToString("0"))%"></div>
                                        <div class="prob-fill-away" style="width: @((p.AwayWinProb * 100).ToString("0"))%"></div>
                                    </div>
                                </div>

                                <!-- Tactical AI Preview Insight -->
                                <div class="p-2.5 rounded mt-3" style="background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.16); font-size: 0.815rem; line-height: 1.45; color: #cbd5e1;">
                                    <span class="fw-bold" style="color: var(--brand-primary);"><span class="me-1">🧠</span> Tactical Insight:</span>
                                    @(string.IsNullOrWhiteSpace(p.TacticalInsight) ? p.GenerateTacticalSummary() : p.TacticalInsight)
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- View Mode: Compact Table -->
                <div class="table-responsive">
                    <table class="table table-custom align-middle">
                        <thead>
                            <tr>
                                <th>Kickoff</th>
                                <th>Matchup</th>
                                <th>Expected Goals</th>
                                <th>Prediction</th>
                                <th>1X2 Probabilities</th>
                                <th>Confidence</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in FilteredPredictions.OrderBy(x => x.Kickoff))
                            {
                                <tr>
                                    <td style="white-space: nowrap;">
                                        <div class="fw-semibold">@p.Kickoff.ToString("MMM dd")</div>
                                        <div class="text-secondary small">@p.Kickoff.ToString("HH:mm") GMT</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-light">@p.HomeTeam vs @p.AwayTeam</div>
                                        <div class="text-secondary small" style="font-size: 0.765rem; max-width: 290px;">@p.GenerateTacticalSummary()</div>
                                    </td>
                                    <td>
                                        <span class="xg-badge">⚽ @p.ExpectedHomeGoals.ToString("0.0") - @p.ExpectedAwayGoals.ToString("0.0")</span>
                                    </td>
                                    <td>
                                        <span class="prediction-pill @GetOutcomeClass(p.PredictedOutcome)">
                                            @OutcomeText(p.PredictedOutcome)
                                        </span>
                                    </td>
                                    <td style="min-width: 200px;">
                                        <div class="d-flex justify-content-between small text-secondary mb-1">
                                            <span>H: @((p.HomeWinProb * 100).ToString("0"))%</span>
                                            <span>D: @((p.DrawProb * 100).ToString("0"))%</span>
                                            <span>A: @((p.AwayWinProb * 100).ToString("0"))%</span>
                                        </div>
                                        <div class="probs-bar-visual" style="height: 6px;">
                                            <div class="prob-fill-home" style="width: @((p.HomeWinProb * 100).ToString("0"))%"></div>
                                            <div class="prob-fill-draw" style="width: @((p.DrawProb * 100).ToString("0"))%"></div>
                                            <div class="prob-fill-away" style="width: @((p.AwayWinProb * 100).ToString("0"))%"></div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">@p.Probability.ToString("P0")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery]
    public bool? Refresh { get; set; }

    private PredictionSession? Session { get; set; }
    private string? Status { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool _hasInitialized = false;

    private string ViewMode { get; set; } = "CARDS";
    private string SearchQuery { get; set; } = "";
    private string OutcomeFilter { get; set; } = "ALL";

    protected override async Task OnInitializedAsync()
    {
        _hasInitialized = true;
        await LoadDataAsync(forceRefresh: Refresh == true);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_hasInitialized && Refresh == true)
        {
            Refresh = null;
            Nav.NavigateTo("predict", replace: true);
            await PredictFromBundled(forceRefresh: true);
        }
    }

    private async Task LoadDataAsync(bool forceRefresh = false)
    {
        try
        {
            IsLoading = true;
            Status = "⚡ Loading match predictions and historical models...";
            StateHasChanged();
            await Task.Yield();
            await Task.Delay(50);

            if (await Predictor.IsLocalSeasonBehindAsync(Env.WebRootPath))
            {
                try
                {
                    Status = "The local fixture file is a previous season. Downloading the current season first...";
                    StateHasChanged();
                    await Task.Yield();
                    var msg = await Predictor.UpdateFixturesAsync(Env.WebRootPath);
                    Status = $"{msg} Generating predictions...";
                    StateHasChanged();
                    await Task.Yield();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Auto season update failed; using local CSV");
                    Status = "Could not download the current season. Using local fixtures...";
                    StateHasChanged();
                    await Task.Yield();
                }
            }

            await PredictFromBundled(forceRefresh: forceRefresh);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing predictions");
            Status = $"❌ Error loading predictions: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<FixturePrediction> FilteredPredictions
    {
        get
        {
            if (Session?.NextRoundPredictions == null) return Enumerable.Empty<FixturePrediction>();

            var items = Session.NextRoundPredictions.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var q = SearchQuery.Trim().ToLowerInvariant();
                items = items.Where(x => x.HomeTeam.ToLowerInvariant().Contains(q) || x.AwayTeam.ToLowerInvariant().Contains(q));
            }

            if (OutcomeFilter != "ALL")
            {
                items = items.Where(x => x.PredictedOutcome == OutcomeFilter);
            }

            return items;
        }
    }

    private void SetFilter(string filter) => OutcomeFilter = filter;

    private async Task PredictFromBundled(bool forceRefresh = false)
    {
        try
        {
            IsLoading = true;
            Status = forceRefresh 
                ? "🧠 Retraining Dixon-Coles & Ensemble ML models across all historical seasons..." 
                : "⚡ Loading match predictions...";
            StateHasChanged();
            await Task.Yield();
            await Task.Delay(50);

            Session = await Predictor.PredictFromFileIfExistsAsync(Env.WebRootPath, forceRefresh: forceRefresh);

            if (LlmInsight.IsEnabled && Session?.NextRoundPredictions?.Count > 0)
            {
                Status = "🤖 Generating tactical match previews via Luna / External LLM...";
                StateHasChanged();
                await Task.Yield();
                var tasks = Session.NextRoundPredictions.Select(async p => 
                {
                    var insight = await LlmInsight.GetTacticalInsightAsync(p);
                    return p with { TacticalInsight = insight };
                });
                var enriched = await Task.WhenAll(tasks);
                Session = new PredictionSession
                {
                    LastCompletedRound = Session.LastCompletedRound,
                    NextRound = Session.NextRound,
                    NextRoundPredictions = enriched.ToList(),
                    Backtest = Session.Backtest,
                    InfoMessage = Session.InfoMessage,
                    LoadedSeasons = Session.LoadedSeasons,
                    TotalMatchesTrained = Session.TotalMatchesTrained
                };
            }

            Status = $"✅ AI analysis complete. Generated predictions for Round {Session?.NextRound}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating predictions");
            Status = $"❌ Error: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdateFixtures()
    {
        try
        {
            IsLoading = true;
            Status = "🔄 Downloading latest fixtures and completed results from fixturedownload.com...";
            StateHasChanged();
            await Task.Yield();
            await Task.Delay(50);

            var msg = await Predictor.UpdateFixturesAsync(Env.WebRootPath);
            Status = $"✅ {msg} Retraining models...";
            StateHasChanged();
            await Task.Yield();
            await PredictFromBundled(forceRefresh: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating fixtures");
            Status = $"❌ Fixture update failed: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task SyncAllSeasons()
    {
        try
        {
            IsLoading = true;
            Status = "🌐 Harvesting historical EPL seasons from fixturedownload.com...";
            StateHasChanged();
            await Task.Yield();
            await Task.Delay(50);

            var msg = await Predictor.UpdateAllFixturesAndSeasonsAsync(Env.WebRootPath);
            Status = $"✅ {msg}. Generating updated predictions...";
            StateHasChanged();
            await Task.Yield();
            await PredictFromBundled(forceRefresh: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error syncing historical seasons");
            Status = $"❌ Season sync failed: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string GetMonogram(string team)
    {
        if (string.IsNullOrWhiteSpace(team)) return "FC";
        var parts = team.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }

    private string GetOutcomeClass(string code) => code switch
    {
        "H" => "home-win",
        "D" => "draw",
        "A" => "away-win",
        _ => ""
    };

    private string OutcomeText(string code) => code switch
    {
        "H" => "Home Win",
        "D" => "Draw",
        "A" => "Away Win",
        _ => code
    };
}
