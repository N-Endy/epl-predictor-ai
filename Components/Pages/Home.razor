@page "/"
@using PredictorBlazor.Services
@rendermode InteractiveServer
@inject PredictorService Predictor
@inject IWebHostEnvironment Env
@inject NavigationManager Nav

<PageTitle>EPL Predictor AI - Advanced Sports Analytics</PageTitle>

<!-- Hero Section -->
<div class="glass-card mb-4 text-center py-5 px-3 fade-in" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(6, 182, 212, 0.05) 100%), var(--bg-card);">
    <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill mb-3" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3);">
        <span class="status-dot"></span>
        <span class="fw-bold" style="color: var(--brand-primary); font-size: 0.8rem;">Dixon-Coles & Ensemble ML Core Active</span>
    </div>

    <h1 class="display-5 fw-extrabold mb-3" style="letter-spacing: -0.04em;">
        Predict Every Premier League Matchday with AI
    </h1>
    
    <p class="text-secondary mx-auto mb-4" style="max-width: 680px; font-size: 1.05rem; line-height: 1.6;">
        Combines bivariate Poisson expected goals modeling, time-decay parameters, and Random Forest / Gradient Boosted tree ensembles trained across 2,000+ historical fixtures.
    </p>

    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <button class="btn btn-brand-primary px-4 py-2.5 d-inline-flex align-items-center gap-2" 
                @onclick="NavigateToPredict" 
                disabled="@IsNavigating">
            @if (IsNavigatingToPredict)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Loading Match Predictions...</span>
            }
            else
            {
                <span>🔮 Make Next Round Predictions</span>
            }
        </button>
        <button class="btn btn-brand-secondary px-4 py-2.5 d-inline-flex align-items-center gap-2" 
                @onclick="NavigateToBacktest" 
                disabled="@IsNavigating">
            @if (IsNavigatingToBacktest)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Loading Backtest Suite...</span>
            }
            else
            {
                <span>📊 Run Model Backtest</span>
            }
        </button>
    </div>
</div>

<!-- High-Level Metrics Row -->
<div class="row g-3 mb-4 fade-in">
    <div class="col-6 col-md-3">
        <div class="stat-widget text-center">
            <div class="stat-widget-label">Training Matches</div>
            <div class="stat-widget-value text-success">2,000+</div>
            <div class="stat-widget-sub">Multi-Season Database</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-widget text-center">
            <div class="stat-widget-label">Statistical Model</div>
            <div class="stat-widget-value text-info">Dixon-Coles</div>
            <div class="stat-widget-sub">Time-Decay Poisson</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-widget text-center">
            <div class="stat-widget-label">Ensemble Stack</div>
            <div class="stat-widget-value" style="color: var(--brand-amber);">RF + GBDT</div>
            <div class="stat-widget-sub">Logit Probability Blend</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-widget text-center">
            <div class="stat-widget-label">Benchmark Accuracy</div>
            <div class="stat-widget-value" style="color: #38bdf8;">~60%</div>
            <div class="stat-widget-sub">Walk-Forward Verified</div>
        </div>
    </div>
</div>

<!-- Architecture Breakdown Grid -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <div class="glass-card h-100">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="fs-4">📐</span>
                <h3 class="fs-5 fw-bold mb-0 text-light">Dixon-Coles & Poisson Modeling</h3>
            </div>
            <p class="text-secondary small mb-3" style="line-height: 1.6;">
                Calculates team attack strength (&alpha;), defensive vulnerability (&beta;), home field advantage (&gamma;), and low-score dependence (&tau;) to construct an exact 8 &times; 8 score probability distribution.
            </p>
            <div class="p-2.5 rounded" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); font-size: 0.775rem; color: var(--text-muted);">
                Generates Expected Goals (xG<sub>Home</sub> vs xG<sub>Away</sub>), Over/Under 2.5, and Both Teams to Score (BTTS).
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="glass-card h-100">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="fs-4">🧠</span>
                <h3 class="fs-5 fw-bold mb-0 text-light">Multi-Season Feature Engineering</h3>
            </div>
            <p class="text-secondary small mb-3" style="line-height: 1.6;">
                Dynamic Elo ratings with margin-of-victory scaling, Exponentially Weighted Moving Average (EWMA) form curves, clean sheet rates, fatigue/rest differences, and Head-to-Head records.
            </p>
            <div class="p-2.5 rounded" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); font-size: 0.775rem; color: var(--text-muted);">
                Harvests seasons @HarvestedRange directly from fixturedownload.com with zero manual entry.
            </div>
        </div>
    </div>
</div>

<!-- Workflow Steps -->
<div class="glass-card mb-4">
    <div class="glass-card-header">
        <h2 class="fs-5 fw-bold mb-0 text-light">How to Use the Predictor</h2>
    </div>

    <div class="row g-4 pt-2">
        <div class="col-12 col-md-4">
            <div class="d-flex gap-3">
                <div class="team-avatar home-badge" style="width: 36px; height: 36px; font-size: 0.9rem;">1</div>
                <div>
                    <h4 class="fs-6 fw-bold text-light mb-1">Harvest Data</h4>
                    <p class="text-secondary small mb-0">Click <strong>Sync Multi-Season Data</strong> on the Predictions page to download the latest fixtures and historical seasons.</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="d-flex gap-3">
                <div class="team-avatar" style="width: 36px; height: 36px; font-size: 0.9rem; border-left: 3px solid var(--brand-amber);">2</div>
                <div>
                    <h4 class="fs-6 fw-bold text-light mb-1">Generate 1X2 Probabilities</h4>
                    <p class="text-secondary small mb-0">The AI models train and synthesize pre-match features for the upcoming round with expected goals (xG).</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="d-flex gap-3">
                <div class="team-avatar away-badge" style="width: 36px; height: 36px; font-size: 0.9rem;">3</div>
                <div>
                    <h4 class="fs-6 fw-bold text-light mb-1">Backtest & Verify</h4>
                    <p class="text-secondary small mb-0">Use the walk-forward backtest tool to simulate round-by-round out-of-sample prediction accuracy.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string HarvestedRange { get; set; } = "2018–present";
    private bool IsNavigatingToPredict { get; set; }
    private bool IsNavigatingToBacktest { get; set; }
    private bool IsNavigating => IsNavigatingToPredict || IsNavigatingToBacktest;

    protected override void OnInitialized()
    {
        HarvestedRange = Predictor.GetHarvestedSeasonRangeLabel(Env.WebRootPath);
    }

    private async Task NavigateToPredict()
    {
        if (IsNavigating) return;
        IsNavigatingToPredict = true;
        StateHasChanged();
        await Task.Yield();
        Nav.NavigateTo("predict");
    }

    private async Task NavigateToBacktest()
    {
        if (IsNavigating) return;
        IsNavigatingToBacktest = true;
        StateHasChanged();
        await Task.Yield();
        Nav.NavigateTo("backtest");
    }
}
