@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar">
        <NavMenu/>
    </aside>

    <main>
        <header class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom" style="border-color: var(--border-subtle) !important; background: rgba(11, 16, 28, 0.6); backdrop-filter: blur(12px);">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5" style="font-size: 0.75rem;">
                    🟢 2025/26 Season Live
                </span>
                <span class="text-secondary small d-none d-md-inline">|</span>
                <span class="text-secondary small d-none d-md-inline">Multi-Season ML & Dixon-Coles</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a href="predict" class="btn btn-brand-primary btn-sm px-3 py-1.5" style="font-size: 0.825rem;">
                    🔮 Predict Next Round
                </a>
            </div>
        </header>

        <div class="content-wrapper">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>