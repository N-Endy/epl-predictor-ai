@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar">
        <NavMenu/>
    </aside>

    <main>
        <header class="d-flex justify-content-between align-items-center px-3 px-md-4 py-2.5 py-md-3 border-bottom" style="border-color: var(--border-subtle) !important; background: rgba(11, 16, 28, 0.6); backdrop-filter: blur(12px);">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 px-md-2.5 py-md-1.5" style="font-size: 0.725rem;">
                    🟢 2026/27 Live
                </span>
                <span class="text-secondary small d-none d-md-inline">|</span>
                <span class="text-secondary small d-none d-md-inline">Multi-Season ML & Dixon-Coles</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="predict?refresh=true" class="btn btn-brand-primary btn-sm px-2.5 px-md-3 py-1.5 d-inline-flex align-items-center gap-1" style="font-size: 0.825rem;">
                    <span>🔮</span>
                    <span class="d-none d-sm-inline">Predict Next Round</span>
                    <span class="d-inline d-sm-none">Predict</span>
                </a>
            </div>
        </header>

        <div class="content-wrapper">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
